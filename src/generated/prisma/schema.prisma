// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  member
  qa
  client
}

enum CompanyStatus {
  active
  inactive
}

enum ProjectStatus {
  pending
  in_progress
  completed
}

enum TicketStatus {
  pending
  in_progress
  completed
  reopen
  in_review
  blocked
  backlog
}

enum TicketType {
  feature
  bug
  task
  improvement
  documentation
  other
}

enum Priority {
  high
  medium
  low
}

enum ProjectPhase {
  idea
  discovery
  requirement_gathering
  prototype
  planning
  design
  development
  testing
  review
  deployment
  maintenance
  completed
}

enum ProjectCategory {
  software
  marketing
  design
  interior
  other
}

enum ProjectGroupType {
  sprint
  phase
  section
  milestone
  campaign_stage
  custom
}

enum GroupStatus {
  not_started
  in_progress
  completed
  cancelled
  on_hold
}

enum ProjectDiscussionGroupType {
  general
  discussion
  suggestion
  complaint
  decision
  question
  announcement
  feedback
  improvement
  other
}

enum ActivityAction {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED

  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED

  TICKET_CREATED
  TICKET_UPDATED
  TICKET_DELETED

  TICKET_ASSIGNED
  TICKET_UNASSIGNED

  TICKET_STATUS_CHANGED
  TICKET_PRIORITY_CHANGED

  TICKET_MOVED

  COMMENT_CREATED

  FILE_UPLOADED

  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_REMOVED

  ROLE_CHANGED
}

model Company {
  id            String         @id @default(cuid())
  name          String
  description   String
  status        CompanyStatus  @default(active)
  imageUrl      String
  projects      Project[]
  user          user[]
  notes         Note[]
  projectGroups ProjectGroup[]
}

model user {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(member)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  imageUrl    String?
  isActive    Boolean   @default(true)
  lastActive  DateTime?
  designation String?
  isPending   Boolean   @default(true)

  //auth
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  isVerified                Boolean   @default(false)
  verifyToken               String?
  verifyTokenExpiry         DateTime?

  //relationships
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  timeLogs timeLog[]

  projects      Project[] @relation("ProjectMembers")
  adminProjects Project[] @relation("ProjectAdmins")

  messages Message[]

  assignedTickets   Ticket[]       @relation("assignedTickets")
  assignedByTickets Ticket[]       @relation("assignedByTickets")
  ticketReasons     TicketReason[]

  notes Note[]

  activityLogs            ActivityLog[]
  targetActivityLogs      ActivityLog[]            @relation("ActivityTargetUser")
  uploadedAttachments     TicketAttachment[]       @relation("UploadedAttachments")
  projectDiscussionGroups ProjectDiscussionGroup[]
  joinedDiscussionGroups  ProjectDiscussionGroup[] @relation("DiscussionGroupMembers")

  @@index([companyId, email])
}

model Project {
  id            String          @id @default(cuid())
  title         String
  description   String?
  status        ProjectStatus   @default(pending)
  imageUrl      String?
  isActive      Boolean         @default(true)
  completedDate DateTime?
  targetDate    DateTime?
  startDate     DateTime?
  phase         ProjectPhase    @default(idea)
  category      ProjectCategory @default(software)

  members user[] @relation("ProjectMembers")
  admins  user[] @relation("ProjectAdmins")

  companyId        String
  company          Company                  @relation(fields: [companyId], references: [id])
  discussionGroups ProjectDiscussionGroup[]

  messages Message[]

  timeLogs timeLog[]

  groups ProjectGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
}

model ProjectGroup {
  id          String           @id @default(cuid())
  name        String
  description String
  goal        String?
  type        ProjectGroupType @default(sprint)

  isActive  Boolean     @default(true)
  startDate DateTime
  endDate   DateTime?
  status    GroupStatus @default(not_started)

  tickets Ticket[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectDiscussionGroup {
  id         String                     @id @default(cuid())
  title      String
  type       ProjectDiscussionGroupType @default(discussion)
  content    String?
  isPinned   Boolean                    @default(false)
  isArchived Boolean                    @default(false)

  tickets  Ticket[]
  members  user[]    @relation("DiscussionGroupMembers")
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  userId String
  user   user   @relation(fields: [userId], references: [id])
}

model Ticket {
  id             String       @id @default(cuid())
  title          String
  description    String
  status         TicketStatus @default(pending)
  priority       Priority     @default(low)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dueDate        DateTime?
  isCompleted    Boolean      @default(false)
  completedAt    DateTime?
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  reasonBlocked  String?
  reasonReopen   String?
  type           TicketType   @default(task)
  estimatedHours Float?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  groupId String?
  group   ProjectGroup? @relation(fields: [groupId], references: [id])

  assignedUserId String?
  assignedUser   user?   @relation("assignedTickets", fields: [assignedUserId], references: [id])

  assignedById String?
  assignedBy   user?   @relation("assignedByTickets", fields: [assignedById], references: [id])

  reasons TicketReason[]

  timeLogs timeLog[]

  discussionGroups ProjectDiscussionGroup[]

  attachments TicketAttachment[]

  messages Message[]

  @@index([projectId])
  @@index([groupId])
  @@index([assignedUserId])
  @@index([assignedById])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  fileName     String
  fileUrl      String
  createdAt    DateTime @default(now())
  uploadedById String?
  uploadedBy   user?    @relation("UploadedAttachments", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model Message {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isRead    Boolean  @default(false)
  isStarred Boolean  @default(false)
  isDeleted Boolean  @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  userId String
  user   user   @relation(fields: [userId], references: [id])

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  discussionGroupId String?
  discussionGroup   ProjectDiscussionGroup? @relation(fields: [discussionGroupId], references: [id], onDelete: Cascade)
}

model timeLog {
  id String @id @default(cuid())

  startTime DateTime  @default(now())
  endTime   DateTime?
  duration  Int?

  description String?

  userId String
  user   user   @relation(fields: [userId], references: [id])

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([ticketId])
  @@index([projectId])
  @@index([userId, startTime])
}

model Note {
  id          String   @id @default(cuid())
  title       String
  description String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId    String
  user      user    @relation(fields: [userId], references: [id])
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([userId])
}

model ActivityLog {
  id String @id @default(cuid())

  action ActivityAction

  description String?

  metadata Json?

  userId String
  user   user   @relation(fields: [userId], references: [id])

  targetUserId String?
  targetUser   user?   @relation("ActivityTargetUser", fields: [targetUserId], references: [id])

  projectId String?
  ticketId  String?
  groupId   String?

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([ticketId])
  @@index([groupId])
  @@index([createdAt])
}

model TicketReason {
  id        String           @id @default(cuid())
  type      TicketReasonType
  reason    String
  createdAt DateTime         @default(now())

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  userId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
}

enum TicketReasonType {
  BLOCKED
  REOPENED
}
